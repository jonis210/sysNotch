# ==========================================
# SysNotch / Dynamic Island - .gitignore
# ==========================================

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyd

# --- PyInstaller Build Outputs ---
build/
dist/
*.manifest

# --- Binary Executables & Distribution Archives ---
# (Disarankan di-upload ke menu 'Releases' di GitHub agar repo tetap cepat saat di-clone)
*.exe
*.zip
*.old.*

# --- Diagnostic & Log Files ---
*.log
crash_log.txt

# --- Windows System Files ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Code Editor & IDE Configurations ---
.vscode/
.idea/
*.suo
*.user
*.sublime-project
*.sublime-workspace

# --- Temporary Scratch Files & Test Artifacts ---
scratch/
debug_*.py
test_*.py
DynamicIsland_Project/
assets/test_*.png
assets/anim_frame_*.png
assets/actual_*.png
assets/*comparison*.png
assets/*inspection*.png
assets/*proof*.png
docs/

{
  "manifest_version": 3,
  "name": "Dynamic Island YouTube Skip",
  "version": "1.0.6",
  "description": "Menghubungkan deteksi iklan dan tombol Skip ad YouTube ke Dynamic Island.",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "permissions": [
    "alarms",
    "debugger",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
